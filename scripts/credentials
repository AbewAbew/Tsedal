#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$0")/env.sh"
"$TSEDAL_ROOT/.local/bench-cli/bin/python" - "$TSEDAL_ROOT" <<'PY'
import json, sys
from pathlib import Path
data = json.loads((Path(sys.argv[1]) / '.local/credentials.json').read_text())
print('URL: http://tsedal.localhost:18780/login')
print('Username: Administrator')
print('Password:', data['administrator_password'])
PY
